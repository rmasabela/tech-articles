flowchart TD
    subgraph LocalDev["1. Local Authoring and Build"]
        A["gems/{gem-slug}/ (meta.yaml + instructions.md)"] --> B["scripts/build-gem.py"]
        S["schemas/gem-configuration.schema.json"] -->|Contract validation| B
        B --> C["dist/{gem-slug}.json"]
    end

    subgraph GitHubActions["2. Automated CI/CD Engine"]
        CI["CI Workflow: ci.yml (Schema Audit)"]
        CD["CD Workflow: deploy.yml (Index Catalog)"]
        Pages["GitHub Pages (Static REST API)"]

        CI -->|workflow_run: success| CD
        CD -->|Deploy Pages artifact| Pages
    end

    subgraph LastMile["3. Last-Mile Web UI Deployment"]
        TM["Tampermonkey Userscript (gem-studio-sync.user.js)"]
        UI["Google Gemini Web Interface (Form Hydration)"]

        TM -->|DOM Event Dispatch| UI
    end

    C -.->|Push to main| CI
    Pages -->|Fetch index and manifests| TM

    classDef local fill:#1e1e2e,stroke:#89b4fa,stroke-width:1px,color:#cdd6f4;
    classDef ci fill:#181825,stroke:#a6e3a1,stroke-width:1px,color:#cdd6f4;
    classDef ui fill:#11111b,stroke:#fab387,stroke-width:1px,color:#cdd6f4;

    class A,B,S,C local;
    class CI,CD,Pages ci;
    class TM,UI ui;
